                "${workspaceFolder}/.vscode/ps2sdk-headers/iop/include",
                "${workspaceFolder}/.vscode/ps2sdk-headers/ee-gcc/include",
                "${workspaceFolder}/.vscode/ps2sdk-headers/ee-gcc/include-fixed",
